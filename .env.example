# ------------------------------------------------------------------
# Copiar este archivo como .env.local y llenar los valores.
# .env.local NO se sube al repo (ya esta en .gitignore).
#
# El envio usa el SMTP de Google Workspace.
# Para obtener SMTP_PASS:
#   1. La cuenta debe tener verificacion en dos pasos activada.
#   2. Ir a myaccount.google.com/apppasswords
#   3. Generar una contrasena de aplicacion y pegarla abajo SIN espacios.
# ------------------------------------------------------------------

# Cuenta de Google Workspace que envia los correos
SMTP_USER=contacto@nexolabs.tech

# Contrasena de aplicacion de 16 caracteres (NO la contrasena normal)
SMTP_PASS=abcdefghijklmnop

# Correo que recibe las solicitudes. Si se omite, usa SMTP_USER.
CONTACT_TO=contacto@nexolabs.tech
